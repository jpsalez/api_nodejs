{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "authUser",
    "type": "object",
    "properties": {
        "user_name": { "type": "string" },
        "email": { "type": "string", "format": "email"},
        "password": { "type": "string", "minLength": 6 }
    },
    "required": [
        "password"
    ],
    "oneOf": [
        {"required": ["email"]},
         {"required": ["user_name"]}
    ],
    "additionalProperties": false
}
